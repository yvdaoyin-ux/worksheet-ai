# Copy this file to `.env` (local) and/or paste these into Vercel project settings.

# ---- Option A (recommended): OpenRouter ----
# No credit card, no ID verification. Sign in with Google at https://openrouter.ai
# Get a key at https://openrouter.ai/keys  (starts with sk-or-)
OPENROUTER_API_KEY=
# Optional: pick a free model. See https://openrouter.ai/models?max_price=0
# NOTE: avoid Google-routed models (they may block some regions).
# Default if left blank: qwen/qwen3.8-27b:free
OPENROUTER_MODEL=

# ---- Option B: Google Gemini direct ----
# Requires a Google Cloud project. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gumroad product id, used to verify license keys.
GUMROAD_PRODUCT_ID=
