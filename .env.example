# Copy this file to `.env` (local) and/or paste these into Vercel project settings.

# ---- Groq (recommended): fast + generous free tier ----
# Sign up at https://console.groq.com , create an API key (starts with gsk_).
GROQ_API_KEY=
# Optional override (comma-separated). Default: openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_MODEL=

# ---- OpenRouter (fallback) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---- DeepSeek (cheap PAID fallback; keeps the product up when a free tier
#      hits its rate limit). Sign up at https://platform.deepseek.com ----
DEEPSEEK_API_KEY=
# deepseek-v4-flash is the current cheapest tier ($0.14 in / $0.28 out per 1M).
# The old deepseek-chat / deepseek-reasoner names were retired 2026-07-24.
DEEPSEEK_MODEL=

# ---- Gumroad product ids, used to verify license keys ----
# Basic = one-time ($19, code LAUNCH30 -> $13.30). Get it from the product's "Advanced" tab.
GUMROAD_PRODUCT_ID=
# Pro = monthly membership ($4.99/mo). A Gumroad product can't be both one-time and
# subscription, so Basic and Pro are always two separate products.
GUMROAD_PRO_PRODUCT_ID=

# ---- Optional: anti-abuse per-IP daily limit (Upstash Redis free tier) ----
# Create a free Redis database at https://upstash.com , then copy its REST URL and token.
# If unset, the limit falls back to an in-memory per-IP counter (see api/generate.js).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DAILY_LIMIT_PER_IP=100
# Used only by the in-memory fallback when UPSTASH_REDIS_REST_URL is unset.
MEM_LIMIT_PER_IP_DAY=60

# ---- Optional: email capture (/api/subscribe). If unset, emails are only logged. ----
BUTTONDOWN_API_KEY=
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# ---- Optional: analytics forwarding (/api/track). If unset, events are only logged. ----
PLAUSIBLE_DOMAIN=
PLAUSIBLE_API_KEY=
