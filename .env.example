# Copy this file to `.env` (local) and/or paste these into Vercel project settings.

# ---- Groq (recommended): fast + generous free tier ----
# Sign up at https://console.groq.com , then create an API key (starts with gsk_).
GROQ_API_KEY=
# Optional: override the models (comma-separated). Default:
#   llama-3.3-70b-versatile,llama-3.1-8b-instant
GROQ_MODEL=

# ---- OpenRouter (fallback) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Gumroad product id, used to verify license keys.
GUMROAD_PRODUCT_ID=
